{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "KINGLET_PORT",
    "KINGLET_API_URL",
    "KINGLET_DB_PATH",
    "KINGLET_DB_AUTH_TOKEN",
    "KINGLET_STORAGE",
    "KINGLET_TOKENS",
    "KINGLET_BASE_URL",
    "KINGLET_RETENTION_DAYS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
