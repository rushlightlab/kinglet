{
  "name": "@kinglet/sdk-node",
  "version": "0.3.0",
  "description": "Batching log client for Kinglet — small, light, king.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@kinglet/config": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
