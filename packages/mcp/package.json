{
  "name": "@kinglet/mcp",
  "version": "0.3.0",
  "description": "MCP server for Kinglet — query logs and manage monitors from AI clients.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kinglet-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rushlightlab/kinglet.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://kinglet.rushlightlab.com/mcp/",
  "bugs": {
    "url": "https://github.com/rushlightlab/kinglet/issues"
  },
  "keywords": [
    "kinglet",
    "mcp",
    "logs",
    "logging",
    "ai"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kinglet/config": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
