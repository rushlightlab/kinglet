# Kinglet configuration (docker compose reads this file if copied to .env)

# Tokens allowed to ingest/query logs (comma-separated).
# Leave unset to auto-generate one on first boot
# (printed to the console and written next to the database as kinglet.token).
# KINGLET_TOKENS=tok_change_me

# Storage backend: "auto" (default — picks by db path scheme), "sqlite", or "libsql".
# sqlite is the zero-config default. libsql works with local file: databases
# and with remote Turso databases.
KINGLET_STORAGE=auto

# Where logs live. Plain paths use better-sqlite3; anything starting with
# libsql://, https://, wss:// or file: uses the libSQL driver instead.
KINGLET_DB_PATH=/data/kinglet.db
# Turso example:
# KINGLET_DB_PATH=libsql://your-db.turso.io
# Auth token for remote libSQL/Turso (not needed for local files):
# KINGLET_DB_AUTH_TOKEN=eyJhbGciOiJF...

# Drop events older than this many days.
KINGLET_RETENTION_DAYS=14

# Port inside the container.
KINGLET_PORT=3000
