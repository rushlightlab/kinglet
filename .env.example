# Kinglet configuration
#
# Copy to .env (docker compose loads it) and uncomment what you need. Values
# are the defaults, except where a comment says "for example". Full reference:
# https://kinglet.rushlightlab.com/self-hosting/#configuration

# =============================================================================
# 1. Start here: set these before Kinglet is reachable by anyone else
# =============================================================================

# The exact URL you open in the browser. Used for secure cookies, sign-in
# origin checks, and links in alerts. Use HTTPS in production. For example:
# KINGLET_BASE_URL=https://logs.example.com

# The first administrator, used only while no administrator exists. Without a
# password, one is generated, printed once, and written to admin-password.txt
# next to a local database. For example:
# KINGLET_ADMIN_EMAIL=you@example.com
# KINGLET_ADMIN_PASSWORD=change-me-please

# Encrypts stored notification channel secrets (webhook URLs, bot tokens, API
# keys). Needed to add or change channels. Back it up apart from /data: a lost
# key means re-entering channel settings.
# Generate with: openssl rand -base64 32
# KINGLET_SECRET_KEY=

# Signs sign-in sessions. Required with a remote database (Turso/libSQL URL in
# KINGLET_DB_PATH): Kinglet won't start without it. With a local database it's
# optional: if unset, one is generated and kept in /data/auth-secret.txt. Set it
# now if you run several instances or want it backed up with your other
# secrets; changing it later signs everyone out.
# Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# =============================================================================
# 2. Network
# =============================================================================

# Port inside the container.
# KINGLET_PORT=3000

# Interface to bind. Unset listens on all interfaces; 127.0.0.1 keeps an
# unproxied instance reachable only from this host, for example:
# KINGLET_HOST=127.0.0.1

# Behind a reverse proxy: the proxy's own address (or its dedicated network),
# so X-Forwarded-For is trusted from it alone. Not a client allowlist: never a
# LAN or VPN range. Leave unset when clients reach Kinglet directly. For example:
# KINGLET_TRUSTED_PROXIES=172.30.0.10/32

# =============================================================================
# 3. Storage and retention
# =============================================================================

# Where logs live. A path (or file: URL) is a local SQLite file; libsql://,
# http(s)://, or ws(s):// connects to remote libSQL/Turso. The Docker image
# sets /data/kinglet.db.
# KINGLET_DB_PATH=/data/kinglet.db
# For Turso, for example (the token is for remote libSQL only):
# KINGLET_DB_PATH=libsql://your-db.turso.io
# KINGLET_DB_AUTH_TOKEN=

# Storage backend: auto (picks from KINGLET_DB_PATH), sqlite, or libsql.
# KINGLET_STORAGE=auto

# Message search index. substring: any 3+ character fragment. words: words and
# word prefixes (lighter: ~20% faster ingest, ~22% less disk). off: no index,
# text filters scan the time window. Changing it rebuilds the index at boot.
# KINGLET_SEARCH=substring

# Days to keep events, and days to keep alert history.
# KINGLET_RETENTION_DAYS=14
# KINGLET_ALERT_RETENTION_DAYS=90

# Timezone for backup and archive schedules. Defaults to the system timezone;
# for example:
# KINGLET_TIMEZONE=UTC

# =============================================================================
# 4. Limits (0 turns a limit off)
# =============================================================================

# KINGLET_MAX_EVENTS_PER_PROJECT=1000000
# KINGLET_MAX_PROJECT_DB_MB=1024
# KINGLET_MAX_DB_MB=4096

# =============================================================================
# 5. Sessions
# =============================================================================

# Days a web session lasts.
# KINGLET_SESSION_DAYS=30

# =============================================================================
# 6. Notifications
# =============================================================================

# Let webhook channels and self-hosted ntfy/Gotify servers use private or
# internal addresses. Blocked by default (SSRF protection).
# KINGLET_ALLOW_PRIVATE_WEBHOOKS=1

# SMTP server for email channels. Email channels need HOST and FROM; Resend and
# Plunk channels use their own API keys instead. For example:
# KINGLET_SMTP_HOST=smtp.example.com
# KINGLET_SMTP_FROM=Kinglet <alerts@example.com>
# Port 587 by default, 465 when KINGLET_SMTP_SECURE=1.
# KINGLET_SMTP_PORT=587
# KINGLET_SMTP_USER=kinglet@example.com
# KINGLET_SMTP_PASSWORD=
# TLS from the first byte; on by default for port 465. Otherwise STARTTLS is
# used when the server offers it.
# KINGLET_SMTP_SECURE=0
# Refuse to send without TLS. On by default once a user is set; 0 only for a
# trusted local relay.
# KINGLET_SMTP_REQUIRE_TLS=1

# =============================================================================
# 7. MCP (AI clients)
# =============================================================================

# Let MCP keys with monitors.write create, update, and delete monitors. Off by
# default: log content can steer an AI client's tool calls, so enable it only
# when the client asks you before acting.
# KINGLET_MCP_ALLOW_MONITOR_WRITES=1

# =============================================================================
# 8. S3 backups (optional)
# =============================================================================

# Backups stay off until the four required values are set; a partial setup
# logs one warning at boot (names only). HTTPS is required except for
# loopback test endpoints. For example:
# KINGLET_BACKUP_S3_BUCKET=kinglet-backups
# KINGLET_BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# KINGLET_BACKUP_S3_ACCESS_KEY_ID=
# KINGLET_BACKUP_S3_SECRET_ACCESS_KEY=

# Optional S3 settings.
# KINGLET_BACKUP_S3_REGION=auto
# KINGLET_BACKUP_S3_PREFIX=kinglet
# KINGLET_BACKUP_S3_SESSION_TOKEN=
# KINGLET_BACKUP_S3_FORCE_PATH_STYLE=false
# Server-side encryption: AES256, aws:kms (needs KMS_KEY_ID), or none.
# KINGLET_BACKUP_S3_SSE=AES256
# KINGLET_BACKUP_S3_KMS_KEY_ID=

# Encrypt snapshots with this age passphrase. Losing it makes those snapshots
# unrecoverable; when set, restores accept only encrypted snapshots.
# KINGLET_BACKUP_PASSPHRASE=

# Key for signing snapshot manifests. Defaults to the S3 secret access key; set
# your own if that credential rotates.
# KINGLET_BACKUP_MANIFEST_SECRET=

# Largest snapshot (or restored database) to accept, and the upload part size
# (minimum 5).
# KINGLET_BACKUP_MAX_SNAPSHOT_MB=8192
# KINGLET_BACKUP_PART_SIZE_MB=8

# =============================================================================
# 9. Legacy compatibility: leave these unset on new installs
# =============================================================================

# Restore snapshots made before manifests were signed.
# KINGLET_BACKUP_ALLOW_UNSIGNED_MANIFESTS=1

# Restore unencrypted snapshots while KINGLET_BACKUP_PASSPHRASE is set (for
# snapshots taken before you added the passphrase).
# KINGLET_BACKUP_ALLOW_UNENCRYPTED_SNAPSHOTS=1

# Older name for BETTER_AUTH_SECRET, still read when that is unset.
# KINGLET_AUTH_SECRET=
