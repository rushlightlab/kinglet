# Kinglet configuration (docker compose reads this file if copied to .env)

# --- bootstrap administrator (when no administrator exists) ---
# KINGLET_ADMIN_EMAIL=you@example.com
# If unset, a password is generated and printed to the console. For a local
# database it is also written to admin-password.txt next to the database.
# KINGLET_ADMIN_PASSWORD=change-me-please

# Web session lifetime in days.
KINGLET_SESSION_DAYS=30

# --- storage ---
# Storage backend: "auto" (default — picks by db path scheme), "sqlite", or "libsql".
KINGLET_STORAGE=auto

# Where logs live. Plain paths use better-sqlite3; anything starting with
# libsql://, https://, wss:// or file: uses the libSQL driver instead.
KINGLET_DB_PATH=/data/kinglet.db
# Turso example:
# KINGLET_DB_PATH=libsql://your-db.turso.io
# Auth token for remote libSQL/Turso (not needed for local files):
# KINGLET_DB_AUTH_TOKEN=eyJhbGciOiJF...

# Drop events older than this many days.
KINGLET_RETENTION_DAYS=14

# Drop alert history older than this many days.
KINGLET_ALERT_RETENTION_DAYS=90

# Port inside the container.
KINGLET_PORT=3000

# Public URL of this Kinglet instance — used for deep links inside alert
# notifications and for Better Auth origin/secure-cookie handling.
# Use your HTTPS URL in production (cookies become Secure automatically).
# KINGLET_BASE_URL=https://logs.example.com

# Better Auth signing secret. Optional: when unset, a random secret is
# generated and persisted at /data/auth-secret.txt (0600). Set explicitly if
# you run more than one instance against the same database.
# BETTER_AUTH_SECRET=

# Only trust X-Forwarded-For from the reverse proxy's address or its dedicated
# network. This is not a client allowlist; do not use LAN/VPN ranges.
# Leave unset if the app is directly exposed.
# KINGLET_TRUSTED_PROXIES=172.30.0.10/32

# Allow webhook/Discord/Slack channels that point at private/internal hosts.
# Private targets are blocked by default (SSRF protection).
# KINGLET_ALLOW_PRIVATE_WEBHOOKS=1

# --- S3 backups (optional) ---
# The Backups tab and scheduler stay disabled until all four required values
# are present. A partial configuration logs one warning at boot (names only).
# KINGLET_BACKUP_S3_BUCKET=kinglet-backups
# KINGLET_BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# KINGLET_BACKUP_S3_REGION=auto
# KINGLET_BACKUP_S3_ACCESS_KEY_ID=<access-key-id>
# KINGLET_BACKUP_S3_SECRET_ACCESS_KEY=<secret-access-key>
# KINGLET_BACKUP_S3_SESSION_TOKEN=
# KINGLET_BACKUP_S3_PREFIX=kinglet
# KINGLET_BACKUP_S3_FORCE_PATH_STYLE=false
# Server-side encryption: AES256, aws:kms, or none.
# KINGLET_BACKUP_S3_SSE=AES256
# KINGLET_BACKUP_S3_KMS_KEY_ID=
# Optional client-side age passphrase for snapshot downloads and restores.
# Losing it makes encrypted snapshots unrecoverable.
# KINGLET_BACKUP_PASSPHRASE=
# Multipart part size in MiB (minimum 5).
# KINGLET_BACKUP_PART_SIZE_MB=8
# Default timezone for backup and archive schedules.
# KINGLET_TIMEZONE=UTC

# Hard caps (0 disables the cap). Leave the defaults unless you need tighter
# multi-tenant limits; retention and disk alerts still apply.
# KINGLET_MAX_EVENTS_PER_PROJECT=1000000
# KINGLET_MAX_PROJECT_DB_MB=1024
# KINGLET_MAX_DB_MB=4096
