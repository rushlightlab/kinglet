{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/coverage/**",
    "apps/web/src/routeTree.gen.ts",
    "apps/api/drizzle/**",
    "data/**",
    "**/*.db",
    "**/*.db-wal",
    "**/*.db-shm"
  ]
}
