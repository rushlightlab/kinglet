{
  "name": "@kinglet/api",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/index.js",
    "restore": "node dist/restore/cli.js",
    "archive:import": "node dist/archive/cli.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/lib-storage": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@hono/node-server": "^2.1.11",
    "@libsql/client": "^0.18.0",
    "@react-email/body": "0.3.0",
    "@react-email/button": "0.2.1",
    "@react-email/container": "0.0.16",
    "@react-email/head": "0.0.13",
    "@react-email/heading": "0.0.16",
    "@react-email/hr": "0.0.12",
    "@react-email/html": "0.0.12",
    "@react-email/link": "0.0.13",
    "@react-email/preview": "0.0.14",
    "@react-email/render": "2.2.0",
    "@react-email/section": "0.0.17",
    "@react-email/text": "0.1.6",
    "age-encryption": "^0.3.1",
    "better-auth": "^1.7.27",
    "croner": "^11.0.1",
    "cronstrue": "^3.43.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.20",
    "nodemailer": "10.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@kinglet/config": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
