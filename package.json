{
  "name": "kinglet",
  "version": "0.3.0",
  "private": true,
  "description": "Small. Light. King. — a tiny self-hostable log platform.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "demo:logs": "node scripts/demo-logs.mjs",
    "demo:webhook": "node scripts/webhook-catcher.mjs"
  },
  "devDependencies": {
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "turbo": "^2.5.0"
  }
}
